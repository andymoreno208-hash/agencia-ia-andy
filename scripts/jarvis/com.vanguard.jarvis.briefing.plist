  <key>StandardOutPath</key>
  <string>__JARVIS_HOME__/.jarvis/launchd-briefing.out.log</string>
  <key>StandardErrorPath</key>
  <string>__JARVIS_HOME__/.jarvis/launchd-briefing.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
