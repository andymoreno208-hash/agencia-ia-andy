#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<EOF
Jarvis — asistente en Mac

Uso:
  jarvis                 Da el briefing (voz)
  jarvis briefing        Igual que arriba
  jarvis briefing text   Solo imprime el texto
  jarvis install         Instala servicios en la Mac
EOF
}

case "${1:-briefing}" in
  briefing)
    exec "${SCRIPT_DIR}/briefing.sh" "${2:-speak}"
    ;;
  install)
    exec "${SCRIPT_DIR}/install.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Comando desconocido: $1" >&2
    usage >&2
    exit 1
    ;;
esac
