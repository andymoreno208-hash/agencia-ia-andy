#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
SERVE_PY="${REPO_ROOT}/scripts/jarvis_serve.py"

usage() {
  cat <<EOF
Jarvis — asistente en Mac

Uso:
  jarvis                 Da el briefing (voz)
  jarvis briefing        Igual que arriba
  jarvis briefing text   Solo imprime el texto
  jarvis serve           Servidor local (puerto 8765)
  jarvis install         Instala servicios en la Mac
EOF
}

if [[ -f "$SERVE_PY" ]]; then
  case "${1:-briefing}" in
    briefing)
      mode="${2:-speak}"
      if [[ "$mode" == "text" ]]; then
        exec python3 "$SERVE_PY" briefing --text
      fi
      exec python3 "$SERVE_PY" briefing
      ;;
    serve)
      exec python3 "$SERVE_PY" serve
      ;;
    install)
      exec python3 "$SERVE_PY" install
      ;;
  esac
fi

case "${1:-briefing}" in
  briefing)
    exec "${SCRIPT_DIR}/briefing.sh" "${2:-speak}"
    ;;
  install)
    exec "${SCRIPT_DIR}/install.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Comando desconocido: $1" >&2
    usage >&2
    exit 1
    ;;
esac
